# Bot (./run.sh) needs both. CLI (./cli.sh) needs only CURSOR_API_KEY.
# Filled interactively on first start if left empty.
TELEGRAM_BOT_TOKEN=
CURSOR_API_KEY=

# Target git repo (default: directory you ran ./run.sh from)
# REPO_CWD=

# Optional — defaults shown
# ALLOWED_USER_IDS=          # empty = first user who DMs the bot is auto-added
# ALLOWED_CHAT_IDS=          # empty = any chat (still filtered by user)
# FORUM_MODE=0
# FORUM_CHAT_ID=
# CURSOR_MODEL=auto
# BOT_DATA_DIR=              # default: ./data
