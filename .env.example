# Telegram BotFather token
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot
# Get yours: message @userinfobot or check getUpdates
ALLOWED_USER_IDS=

# Restrict to forum/group chat ids (recommended). Example: -1001234567890
ALLOWED_CHAT_IDS=

# Forum topics mode: each /task creates a new topic; follow-ups stay in that topic
FORUM_MODE=1
# Supergroup id with Topics enabled (same as ALLOWED_CHAT_IDS if only one)
FORUM_CHAT_ID=

# Cursor user API key (Dashboard → API Keys). Bills to your Cursor plan.
CURSOR_API_KEY=

# Repo the local agent edits (HugSalesSolo root)
REPO_CWD=/home/starl/HugSalesSolo

# Model id for local agent (required by SDK). Use "auto" to let Cursor pick.
CURSOR_MODEL=auto

# Optional override; default = data/ next to this bot
# BOT_DATA_DIR=
